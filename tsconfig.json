{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/ui/gradientClient.ts",
    "src/ui/metadataClient.ts",
    "src/ui/tableClient.ts",
    "src/ui/documentClient.ts",
    "src/ui/niftiClient.ts"
  ]
}
