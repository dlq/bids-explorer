{
  "name": "bids-explorer",
  "displayName": "BIDS Explorer",
  "description": "Browse BIDS studies, preview metadata and open NIfTI images locally or over SSH.",
  "version": "1.0.0",
  "publisher": "bids-explorer-dev",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bidsExplorer.showAvailability",
        "title": "BIDS Explorer: Show Participant Availability",
        "icon": "$(table)"
      },
      {
        "command": "bidsExplorer.refresh",
        "title": "BIDS Explorer: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "bidsExplorer.addDataset",
        "title": "BIDS Explorer: Add Dataset",
        "icon": "$(add)"
      },
      {
        "command": "bidsExplorer.removeDataset",
        "title": "BIDS Explorer: Remove Dataset",
        "icon": "$(close)"
      },
      {
        "command": "bidsExplorer.showDetails",
        "title": "BIDS Explorer: Show Source Details",
        "icon": "$(info)"
      },
      {
        "command": "bidsExplorer.openImageWith",
        "title": "BIDS Explorer: Open Image With..."
      },
      {
        "command": "bidsExplorer.openFile",
        "title": "BIDS Explorer: Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bidsExplorer.cancel",
        "title": "BIDS Explorer: Cancel Pending Work",
        "icon": "$(debug-stop)"
      },
      {
        "command": "bidsExplorer.showInFileExplorer",
        "title": "BIDS Explorer: Show Dataset in File Explorer",
        "icon": "$(files)"
      },
      {
        "command": "bidsExplorer.previewGradients",
        "title": "BIDS Explorer: Preview Diffusion Gradients"
      },
      {
        "command": "bidsExplorer.previewMetadata",
        "title": "BIDS Explorer: Preview JSON Metadata"
      },
      {
        "command": "bidsExplorer.inspectMetadata",
        "title": "BIDS Explorer: Inspect Metadata and Related Files"
      },
      {
        "command": "bidsExplorer.previewParticipants",
        "title": "BIDS Explorer: Preview Participants Table"
      },
      {
        "command": "bidsExplorer.previewTable",
        "title": "BIDS Explorer: Preview BIDS Table"
      },
      {
        "command": "bidsExplorer.previewHistory",
        "title": "BIDS Explorer: Preview Dataset History"
      },
      {
        "command": "bidsExplorer.inspectZip",
        "title": "BIDS Explorer: Inspect ZIP Archive"
      },
      {
        "command": "bidsExplorer.inspectTar",
        "title": "BIDS Explorer: Inspect Tar Archive"
      },
      {
        "command": "bidsExplorer.inspectSquashfs",
        "title": "BIDS Explorer: Inspect SquashFS Image"
      },
      {
        "command": "bidsExplorer.browseSquashfs",
        "title": "BIDS Explorer: Browse SquashFS Image"
      },
      {
        "command": "bidsExplorer.clearImageCache",
        "title": "BIDS Explorer: Clear Extracted Image Cache"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "bidsExplorer.datasets",
          "name": "BIDS"
        }
      ],
      "bidsExplorer-image": [
        {
          "id": "bidsExplorer.imageControls",
          "name": "Image",
          "type": "webview",
          "icon": "media/icons/imaging-dark.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bidsExplorer.datasets",
        "contents": "Open a BIDS dataset folder in VS Code, or choose a folder to browse here. BIDS Explorer leaves your dataset files unchanged.\n[Add Dataset](command:bidsExplorer.addDataset)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bidsExplorer.addDataset",
          "when": "view == bidsExplorer.datasets",
          "group": "navigation@0"
        },
        {
          "command": "bidsExplorer.refresh",
          "when": "view == bidsExplorer.datasets",
          "group": "navigation@1"
        },
        {
          "command": "bidsExplorer.cancel",
          "when": "view == bidsExplorer.datasets",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "bidsExplorer.showAvailability",
          "when": "view == bidsExplorer.datasets && viewItem == dataset",
          "group": "navigation@1"
        },
        {
          "command": "bidsExplorer.removeDataset",
          "when": "view == bidsExplorer.datasets && viewItem == dataset",
          "group": "inline"
        },
        {
          "command": "bidsExplorer.refresh",
          "when": "view == bidsExplorer.datasets && (viewItem == dataset || viewItem == directory)",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.openImageWith",
          "when": "view == bidsExplorer.datasets && (viewItem == file || viewItem == archiveImage) && resourceFilename =~ /\\.nii(\\.gz)?$/",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.openFile",
          "when": "view == bidsExplorer.datasets && viewItem == datasetDescriptionVersions",
          "group": "inline"
        },
        {
          "command": "bidsExplorer.showDetails",
          "when": "view == bidsExplorer.datasets && viewItem != message && viewItem != participantOverview",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.showInFileExplorer",
          "when": "view == bidsExplorer.datasets && viewItem == dataset",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.previewGradients",
          "when": "view == bidsExplorer.datasets && viewItem == gradient",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.previewMetadata",
          "when": "view == bidsExplorer.datasets && viewItem == metadata",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.inspectMetadata",
          "when": "view == bidsExplorer.datasets && (viewItem == file || viewItem == participants || viewItem == summaryTable || viewItem == archiveImage) && resourceFilename =~ /\\.(nii|tsv)(\\.gz)?$/",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.previewParticipants",
          "when": "view == bidsExplorer.datasets && viewItem == participants",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.previewTable",
          "when": "view == bidsExplorer.datasets && viewItem == summaryTable",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.previewHistory",
          "when": "view == bidsExplorer.datasets && viewItem == history",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "bidsExplorer.previewGradients",
          "when": "resourceScheme == file && (resourceExtname == .bval || resourceExtname == .bvec)",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.previewMetadata",
          "when": "resourceScheme == file && resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.previewParticipants",
          "when": "resourceScheme == file && resourceFilename == participants.tsv",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.previewTable",
          "when": "resourceScheme == file && resourceFilename =~ /^sub-[a-zA-Z0-9+]+(_ses-[a-zA-Z0-9+]+)?_(sessions|scans)\\.tsv$/",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.previewHistory",
          "when": "resourceScheme == file && resourceFilename == CHANGES",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.previewTable",
          "when": "resourceScheme == file && resourceFilename =~ /(^|_)events\\.tsv$/",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.inspectZip",
          "when": "resourceScheme == file && resourceExtname == .zip",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.inspectTar",
          "when": "resourceScheme == file && resourceFilename =~ /[.](tar([.]gz)?|tgz)$/i",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.inspectSquashfs",
          "when": "resourceScheme == file && resourceFilename =~ /[.](squashfs|sqfs|sqsh)$/i",
          "group": "navigation"
        },
        {
          "command": "bidsExplorer.browseSquashfs",
          "when": "resourceScheme == file && resourceFilename =~ /[.](squashfs|sqfs|sqsh)$/i",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "BIDS Explorer",
      "properties": {
        "bidsExplorer.participantLabelColumn": {
          "type": "string",
          "default": "",
          "maxLength": 200,
          "scope": "resource",
          "description": "Column in participants.tsv to show next to participant IDs. Leave blank to show the standard labels. A value appears when the participant row and column are unique."
        },
        "bidsExplorer.sessionLabelColumn": {
          "type": "string",
          "default": "",
          "maxLength": 200,
          "scope": "resource",
          "description": "Column in the participant\u2019s sessions.tsv file to show next to session IDs. Leave blank to show the standard labels. A value appears when the session row and column are unique."
        },
        "bidsExplorer.derivativeDatasets": {
          "type": "object",
          "default": {},
          "scope": "window",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^file:"
            }
          },
          "description": "Explicit participant derivative links. Each key is the registered raw dataset's file URI, and its value lists registered derivative dataset file URIs on the workspace host."
        },
        "bidsExplorer.archivePlacements": {
          "type": "object",
          "default": {},
          "scope": "window",
          "additionalProperties": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "archivePath",
                "memberRoot",
                "logicalRoot"
              ],
              "additionalProperties": false,
              "properties": {
                "archivePath": {
                  "type": "string"
                },
                "memberRoot": {
                  "type": "string"
                },
                "logicalRoot": {
                  "type": "string"
                }
              }
            }
          },
          "description": "Saved ZIP and tar placements by registered dataset file URI. Paths are relative to the dataset, the archive member root and the logical dataset root respectively."
        },
        "bidsExplorer.collectionRoots": {
          "type": "array",
          "default": [],
          "maxItems": 1000,
          "items": {
            "type": "string",
            "pattern": "^file:",
            "maxLength": 4096
          },
          "scope": "window",
          "description": "Explicit file: URIs of workspace roots to explore as collections without requiring dataset_description.json. Paths refer to the workspace host. Sources within each declared root share its logical BIDS tree; no dataset files are changed."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bidsExplorer-image",
          "title": "BIDS Image",
          "icon": "media/icons/imaging-dark.svg"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "build": "tsc -p . && tsc -p tsconfig.webview.json",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build && node --test out/test/unit/*.test.js",
    "test:integration": "npm run build && vscode-test --coverage",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test:coverage",
    "vscode:prepublish": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\" && npm run build",
    "package": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && vsce package --out dist/",
    "test:coverage": "npm run build && c8 node --test out/test/unit/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "security:scan": "uvx --python 3.12 --from semgrep==1.183.0 semgrep scan --config .semgrep --metrics=off --disable-version-check --strict --error src",
    "security:rules": "uvx --python 3.12 --from semgrep==1.183.0 semgrep scan --test --config .semgrep/processes.yaml --metrics=off --disable-version-check test/security/processes.ts",
    "security": "npm run security:rules && npm run security:scan",
    "watch:host": "tsc -watch -p .",
    "watch:webview": "tsc -watch -p tsconfig.webview.json"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.96.0",
    "@types/yauzl": "3.4.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.0.0",
    "c8": "^10.1.3",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.4"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "dependencies": {
    "@niivue/niivue": "0.69.0",
    "yauzl": "3.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dlq/bids-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/dlq/bids-explorer/issues"
  },
  "homepage": "https://github.com/dlq/bids-explorer#readme",
  "license": "MIT"
}
